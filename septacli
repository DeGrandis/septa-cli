#!/usr/bin/env node

/**
 * SEPTA Regional Rail CLI Tool
 * Pure JavaScript - ZERO dependencies (only needs built-in `fetch`)
 * 
 * Station names MUST be exact (including spaces and capitalization).
 * Full list: https://www3.septa.org/VIRegionalRail.html
 *
 * Common examples:
 *   "Suburban Station", "30th Street Station", "Jefferson Station",
 *   "Airport Terminal A", "Norristown TC", "Temple U", "Doylestown", "Wilmington", etc.
 * 
 * Output: Markdown by default, use --json for JSON output
 */

const BASE_URL = "https://www3.septa.org/api";

/**
 * Get next departures FROM a station (all directions, with destinations, times, track, status)
 * @param {string} station - exact station name, e.g. "Suburban Station"
 * @param {number} results - how many trains to return (default 10)
 * @returns {Promise<Object>} structured departures by direction
 */
async function getNextDepartures(station, results = 10) {
  const url = `${BASE_URL}/Arrivals/index.php?station=${encodeURIComponent(station)}&results=${results}`;

  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`SEPTA API error: ${response.status} ${response.statusText}`);
  }

  const raw = await response.json();

  // The response has one dynamic key like "Suburban Station Departures: February 12, 2026, 11:02 pm"
  const titleKey = Object.keys(raw)[0];
  const data = raw[titleKey][0] || { Northbound: [], Southbound: [] };

  return {
    station,
    timestamp: titleKey,
    northbound: data.Northbound || [],
    southbound: data.Southbound || []
  };
}

/**
 * Get the next trains that go FROM station X TO station Y
 * Returns scheduled departure from X and arrival at Y (only direct trains)
 * @param {string} fromStation - exact origin station name
 * @param {string} toStation - exact destination station name
 * @param {number} numResults - how many trains to return (default 5)
 * @returns {Promise<Object>} array of trains with departure/arrival times
 */
async function getNextToArrive(fromStation, toStation, numResults = 5) {
  const url = `${BASE_URL}/NextToArrive/index.php?req1=${encodeURIComponent(fromStation)}&req2=${encodeURIComponent(toStation)}&req3=${numResults}`;

  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`SEPTA API error: ${response.status} ${response.statusText}`);
  }

  const trains = await response.json();

  return {
    from: fromStation,
    to: toStation,
    trains: trains
  };
}

/**
 * Get live train status and schedule for all Regional Rail lines
 * Includes train numbers, origins, destinations, next stops, consists, and delays
 * @returns {Promise<Array>} array of all active trains with live status
 */
async function getTrainView() {
  const url = `${BASE_URL}/TrainView/index.php`;

  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`SEPTA API error: ${response.status} ${response.statusText}`);
  }

  const trains = await response.json();

  return trains;
}

/**
 * Get detailed schedule for a specific train by train number
 * @param {string|number} trainNumber - train number (e.g. "2335")
 * @returns {Promise<Array>} detailed schedule with all stops, times, and status
 */
async function getTrainSchedule(trainNumber) {
  const url = `${BASE_URL}/RRSchedules/index.php?req1=${encodeURIComponent(trainNumber)}`;

  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`SEPTA API error: ${response.status} ${response.statusText}`);
  }

  const schedule = await response.json();

  return {
    train_number: trainNumber,
    schedule: schedule
  };
}

// --- Markdown Formatters ---

function formatDeparturesMarkdown(data) {
  let md = `# Departures from ${data.station}\n`;
  md += `*${data.timestamp}*\n\n`;

  if (data.northbound.length > 0) {
    md += `## Northbound\n`;
    md += `| Train | Origin | Destination | Line | Path | Depart | Track | Platform | Service | Status |\n`;
    md += `|-------|--------|-------------|------|------|--------|-------|----------|---------|--------|\n`;
    for (const t of data.northbound) {
      md += `| ${t.train_id || '-'} | ${t.origin || '-'} | ${t.destination || '-'} | ${t.line || '-'} | ${t.path || '-'} | ${t.depart_time || '-'} | ${t.track || '-'} | ${t.platform || '-'} | ${t.service_type || '-'} | ${t.status || '-'} |\n`;
    }
    md += `\n`;
  }

  if (data.southbound.length > 0) {
    md += `## Southbound\n`;
    md += `| Train | Origin | Destination | Line | Path | Depart | Track | Platform | Service | Status |\n`;
    md += `|-------|--------|-------------|------|------|--------|-------|----------|---------|--------|\n`;
    for (const t of data.southbound) {
      md += `| ${t.train_id || '-'} | ${t.origin || '-'} | ${t.destination || '-'} | ${t.line || '-'} | ${t.path || '-'} | ${t.depart_time || '-'} | ${t.track || '-'} | ${t.platform || '-'} | ${t.service_type || '-'} | ${t.status || '-'} |\n`;
    }
    md += `\n`;
  }

  if (data.northbound.length === 0 && data.southbound.length === 0) {
    md += `No departures found.\n`;
  }

  return md;
}

function formatToMarkdown(data) {
  let md = `# Trains from ${data.from} to ${data.to}\n\n`;

  if (data.trains && data.trains.length > 0) {
    md += `| Train | Line | Depart | Arrive | Direct | Status |\n`;
    md += `|-------|------|--------|---------|--------|--------|\n`;
    for (const t of data.trains) {
      const isDirect = t.isdirect === 'true' ? 'Yes' : 'No';
      md += `| ${t.orig_train || '-'} | ${t.orig_line || '-'} | ${t.orig_departure_time || '-'} | ${t.orig_arrival_time || '-'} | ${isDirect} | ${t.orig_delay || '-'} |\n`;
    }
  } else {
    md += `No direct trains found.\n`;
  }

  return md;
}

function formatTrainsMarkdown(trains) {
  let md = `# Active Regional Rail Trains\n`;
  md += `| Train | Line | Origin | Destination | Current | Next Stop | Service | Track | GPS | Heading | Consist | Status |\n`;
  md += `|-------|------|--------|-------------|---------|-----------|---------|-------|-----|---------|---------|--------|\n`;

  for (const t of trains) {
    const late = t.late || 0;
    const status = late > 0 ? `${late} min late` : 'On time';
    const gps = (t.lat && t.lon) ? `${t.lat},${t.lon}` : '-';
    const heading = t.heading ? `${parseFloat(t.heading).toFixed(1)}deg` : '-';
    md += `| ${t.trainno || '-'} | ${t.line || '-'} | ${t.SOURCE || '-'} | ${t.dest || '-'} | ${t.currentstop || '-'} | ${t.nextstop || '-'} | ${t.service || '-'} | ${t.TRACK || '-'} | ${gps} | ${heading} | ${t.consist || '-'} | ${status} |\n`;
  }

  return md;
}

function formatTrainScheduleMarkdown(data) {
  let md = `# Schedule for Train ${data.train_number}\n\n`;
  md += `| Station | Scheduled | Estimated | Actual |\n`;
  md += `|---------|-----------|-----------|--------|\n`;

  for (const stop of data.schedule) {
    md += `| ${stop.station || '-'} | ${stop.sched_tm || '-'} | ${stop.est_tm || '-'} | ${stop.act_tm || '-'} |\n`;
  }

  return md;
}

// --- CLI Logic ---

async function main() {
  const args = process.argv.slice(2); // Remove 'node' and script path

  // Check for --json flag
  const jsonFlagIndex = args.indexOf('--json');
  const wantJson = jsonFlagIndex !== -1;
  if (wantJson) {
    args.splice(jsonFlagIndex, 1);
  }

  if (args.length === 0) {
    console.error("SEPTA Regional Rail CLI\n");
    console.error("Usage:");
    console.error("  septacli departures <station> [results]");
    console.error("  septacli to <fromStation> <toStation> [results]");
    console.error("  septacli trains");
    console.error("  septacli train <trainNumber>");
    console.error("\nOptions:");
    console.error("  --json    Output JSON instead of markdown");
    console.error("\nExamples:");
    console.error('  septacli departures "Suburban Station" 5');
    console.error('  septacli to "30th Street Station" "Airport Terminal A"');
    console.error('  septacli trains');
    console.error('  septacli train 2335');
    process.exit(1);
  }

  const command = args[0];
  let results = 10;

  try {
    if (command === "departures") {
      if (args.length < 2) {
        throw new Error("Missing station name. Usage: septacli departures <station> [results]");
      }
      const station = args[1];
      if (args.length > 2) {
        results = parseInt(args[2], 10);
        if (isNaN(results)) {
          throw new Error("Invalid number for results.");
        }
      }
      const data = await getNextDepartures(station, results);
      if (wantJson) {
        console.log(JSON.stringify(data, null, 2));
      } else {
        console.log(formatDeparturesMarkdown(data));
      }

    } else if (command === "to") {
      if (args.length < 3) {
        throw new Error("Missing stations. Usage: septacli to <fromStation> <toStation> [results]");
      }
      const fromStation = args[1];
      const toStation = args[2];
      if (args.length > 3) {
        results = parseInt(args[3], 10);
        if (isNaN(results)) {
          throw new Error("Invalid number for results.");
        }
      }
      const data = await getNextToArrive(fromStation, toStation, results);
      if (wantJson) {
        console.log(JSON.stringify(data, null, 2));
      } else {
        console.log(formatToMarkdown(data));
      }

    } else if (command === "trains") {
      const data = await getTrainView();
      if (wantJson) {
        console.log(JSON.stringify(data, null, 2));
      } else {
        console.log(formatTrainsMarkdown(data));
      }

    } else if (command === "train") {
      if (args.length < 2) {
        throw new Error("Missing train number. Usage: septacli train <trainNumber>");
      }
      const trainNumber = args[1];
      const data = await getTrainSchedule(trainNumber);
      if (wantJson) {
        console.log(JSON.stringify(data, null, 2));
      } else {
        console.log(formatTrainScheduleMarkdown(data));
      }

    } else {
      throw new Error(`Unknown command: ${command}. Use 'departures', 'to', 'trains', or 'train'`);
    }
  } catch (error) {
    console.error("Error:", error.message);
    process.exit(1);
  }
}

// Execute main
main();
